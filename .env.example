# Copy this file to .env and fill in your own credentials. Never commit .env.

# NASA API key (https://api.nasa.gov) — used for APOD and the Exoplanet Archive,
# sent as the `api_key` query parameter.
NASA_API_KEY=your-nasa-api-key

# Solar System OpenData token (https://api.le-systeme-solaire.net) —
# sent as `Authorization: Bearer <token>`.
SOLAR_SYSTEM_API_TOKEN=your-solar-system-api-token
